generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model auditoria {
  id          BigInt    @id @default(autoincrement())
  usuario_id  BigInt?
  acao        String    @db.VarChar(50)
  entidade    String    @db.VarChar(50)
  entidade_id BigInt?
  detalhes    Json?
  data_hora   DateTime  @default(now()) @db.Timestamp(6)
  ip_origem   String?   @db.Inet
  usuarios    usuarios? @relation(fields: [usuario_id], references: [id], onUpdate: NoAction, map: "fk_auditoria_usuario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model fotos {
  id              BigInt     @id @default(autoincrement())
  visitante_id    BigInt
  caminho_arquivo String     @db.VarChar(500)
  nome_original   String?    @db.VarChar(255)
  tipo_mime       String     @db.VarChar(100)
  tamanho_bytes   BigInt
  criado_em       DateTime   @default(now()) @db.Timestamp(6)
  visitantes      visitantes @relation(fields: [visitante_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_foto_visitante")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuarios {
  id            BigInt      @id @default(autoincrement())
  nome_completo String      @db.VarChar(150)
  email         String      @unique @db.VarChar(150)
  senha_hash    String      @db.VarChar(255)
  perfil        String      @default("operador") @db.VarChar(20)
  ativo         Boolean     @default(true)
  criado_em     DateTime    @default(now()) @db.Timestamp(6)
  atualizado_em DateTime    @default(now()) @db.Timestamp(6)
  auditoria     auditoria[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model visitantes {
  id            BigInt    @id @default(autoincrement())
  nome_completo String    @db.VarChar(150)
  telefone      String?   @db.VarChar(20)
  email         String?   @db.VarChar(150)
  instituicao   String?   @db.VarChar(200)
  menor         Boolean   @default(false)
  criado_em     DateTime  @default(now()) @db.Timestamp(6)
  atualizado_em DateTime  @default(now()) @db.Timestamp(6)
  fotos         fotos[]
  visitas       visitas[]

  @@index([email], map: "idx_visitantes_email")
  @@index([nome_completo], map: "idx_visitantes_nome")
  @@index([telefone], map: "idx_visitantes_telefone")
}

model visitas {
  id                BigInt     @id @default(autoincrement())
  visitante_id      BigInt
  data_hora_entrada DateTime   @default(now()) @db.Timestamp(6)
  finalidade        String?    @db.VarChar(255)
  criado_em         DateTime   @default(now()) @db.Timestamp(6)
  visitantes        visitantes @relation(fields: [visitante_id], references: [id], onUpdate: NoAction, map: "fk_visita_visitante")

  @@index([data_hora_entrada], map: "idx_visitas_data_entrada")
}
